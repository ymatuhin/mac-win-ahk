;; mac-win-shortcuts.kbd
;;
;; kanata config that makes the physical left Win key behave like macOS Cmd.
;; Holding left Win activates the "cmd" layer; tapping it alone does nothing
;; (the Start menu does not open — use the right Win key or Ctrl+Esc).
;;
;; Requires kanata v1.11+. Validate after editing:
;;   kanata --cfg mac-win-shortcuts.kbd --check

(defcfg
  process-unmapped-keys yes
)

;; Every deflayer below must list exactly these keys, in this order.
(defsrc
  lmet tab  spc  ret  bspc
  1    2    3    4    5    6    7    8    9    0
  a    b    c    d    f    g    i    k    l    m    n    o
  p    q    r    s    t    u    v    w    x    z    ,
  left rght up   down
)

;; Virtual Alt used by the Cmd+Tab app switcher: it stays held between
;; Tab presses and is only released when the physical Cmd (left Win) is
;; released, so the switcher behaves like on macOS.
(defvirtualkeys
  vk-alt lalt
)

(defalias
  ;; Left Win = Cmd. Releasing it also releases the virtual Alt,
  ;; committing the app-switcher selection.
  cmd (multi (layer-while-held cmd) (on-release release-virtualkey vk-alt))

  ;; Cmd+Tab: hold Alt virtually and tap Tab. Repeat Tab to cycle;
  ;; hold physical Shift (Cmd+Shift+Tab) to cycle backwards.
  cmd-tab (multi (on-press press-virtualkey vk-alt) tab)

  ;; Cmd+4 = Ctrl+4 (fourth tab), Cmd+Shift+4 = Win+Shift+S (screenshot).
  cmd-4 (fork C-4 M-S-s (lsft rsft))
)

(deflayer base
  @cmd _    _    _    _
  _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _
)

;; Shift is not remapped, so every Cmd+Shift+<key> variant works by
;; holding physical Shift: e.g. Cmd+Shift+Z -> Ctrl+Shift+Z,
;; Cmd+Shift+Left -> Shift+Home.
(deflayer cmd
  _    @cmd-tab M-spc C-ret del
  C-1  C-2  C-3  @cmd-4 C-5 C-6  C-7  C-8  C-9  C-0
  C-a  C-b  C-c  C-d  C-f  C-g  C-i  C-k  C-l  M-down C-n C-o
  C-p  A-f4 C-r  C-s  C-t  C-u  C-v  C-w  C-x  C-z  C-,
  home end  C-home C-end
)
